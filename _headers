/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# Astro fingerprints everything under /_astro/, so a year-long immutable cache is safe.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Media names are stable, not hashed: revalidate daily so a replaced clip still lands.
/media/*
  Cache-Control: public, max-age=86400, must-revalidate

# The v1 kill-switch worker must never be cached, or phones keep the old one.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
